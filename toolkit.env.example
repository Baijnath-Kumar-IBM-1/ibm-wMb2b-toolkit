################################################################################
# B2B Trace Demo — Environment Configuration Example
#
# Copy this file to demo.env and fill in your real values.
# demo.env is listed in .gitignore and must NOT be committed.
################################################################################

# ── B2B SaaS Host ─────────────────────────────────────────────────────────────
B2B_HOST="your-instance.b2b.ipaas.ibm.com"

# ── MCSP Credentials ──────────────────────────────────────────────────────────
MCSP_INSTANCE_ID="your-mcsp-instance-uuid"
MCSP_API_KEY="your-base64-encoded-api-key"

# ── Retail Domain ─────────────────────────────────────────────────────────────
